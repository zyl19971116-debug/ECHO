pragma solidity ^0.8.24;import "@openzeppelin/contracts/access/AccessControl.sol";contract EchoRecordRegistry is AccessControl{bytes32 public constant RECORDER_ROLE=keccak256("RECORDER_ROLE");struct Result{bytes32 resultHash;uint64 finalizedAt;}mapping(uint256=>Result) private results;event ChallengeResultRecorded(uint256 indexed challengeId,bytes32 indexed resultHash,uint64 finalizedAt);constructor(address admin){require(admin!=address(0),"zero admin");_grantRole(DEFAULT_ADMIN_ROLE,admin);_grantRole(RECORDER_ROLE,admin);}function recordChallengeResult(uint256 challengeId,bytes32 resultHash)external onlyRole(RECORDER_ROLE){require(challengeId>0&&resultHash!=bytes32(0),"invalid result");require(results[challengeId].finalizedAt==0,"already recorded");uint64 at=uint64(block.timestamp);results[challengeId]=Result(resultHash,at);emit ChallengeResultRecorded(challengeId,resultHash,at);}function getChallengeResult(uint256 challengeId)external view returns(bytes32,uint64){Result memory r=results[challengeId];return(r.resultHash,r.finalizedAt);}}
